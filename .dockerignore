# Anything that doesn't need to enter the build context.
# Keeps `docker build` fast and keeps secrets out of layers.

# Build outputs
**/node_modules
**/.next
**/.turbo
**/dist
**/build
**/.cache

# Local-only state
.env
.env.*
!.env.example
**/.DS_Store
**/coverage
**/*.log

# Source control
.git
.gitignore
.github

# Editor / OS junk
.vscode
.idea
**/*.swp
**/*~

# Test fixtures and protocol specs are not needed for the web build.
# Keep docs/book in the build context because the web prebuild generates its
# production table of contents from those Markdown sources. The Dockerfile
# does not copy docs into the final runtime image.
tests
ipips
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts

# Other apps not relevant to the web image (the Dockerfile copies just
# their package.json files explicitly so workspace resolution still works).
apps/desktop/src
apps/mobile/src
apps/cli/commands
apps/cli/lib
apps/daemon/src

# Non-build assets
*.pdf
!apps/web/public/book/infernet-book.pdf
INFERNET-*.pdf
