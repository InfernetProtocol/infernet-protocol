{
  "name": "@infernetprotocol/cli",
  "version": "0.1.72",
  "description": "GPU-node CLI / daemon for the Infernet Protocol — register a GPU server with a Supabase control plane and start earning.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "infernet": "./index.js"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "commands/**/*.js",
    "lib/**/*.js",
    "examples/**/*.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node ./index.js"
  },
  "dependencies": {
    "@infernetprotocol/auth": "workspace:*",
    "@infernetprotocol/config": "workspace:*",
    "@infernetprotocol/deploy-providers": "workspace:*",
    "@infernetprotocol/engine": "workspace:*",
    "@infernetprotocol/gpu": "workspace:*",
    "@infernetprotocol/liquid-agent": "workspace:*",
    "@infernetprotocol/rpc-adapter": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@profullstack/x402-client": "^0.3.0",
    "blessed": "^0.1.81",
    "dotenv": "^18.0.9",
    "ora": "^9.4.1",
    "react": "^17.0.2",
    "react-blessed": "^0.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfernetProtocol/infernet-protocol.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/InfernetProtocol/infernet-protocol#readme",
  "keywords": [
    "infernet",
    "gpu",
    "inference",
    "p2p",
    "crypto",
    "cli",
    "daemon"
  ]
}
