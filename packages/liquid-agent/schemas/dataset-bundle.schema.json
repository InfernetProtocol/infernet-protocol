{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infernetprotocol.com/schemas/liquid-agent/v1/dataset-bundle.schema.json",
  "title": "DatasetBundleV1",
  "description": "The file a train or evaluate job reads: a manifest plus the episodes it names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "manifest", "episodes"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "kind": { "const": "dataset_bundle" },
    "manifest": { "$ref": "dataset-manifest.schema.json" },
    "episodes": { "type": "array", "minItems": 1, "items": { "$ref": "episode.schema.json" } }
  }
}
